{
  "name": "vortex9",
  "version": "1.3.0",
  "private": true,
  "description": "Vortex9 sovereign digital shield for Windows and macOS.",
  "author": "mystic9.net",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "app:dev": "electron .",
    "check": "node shield/self-check.js",
    "build:win": "electron-builder --win nsis zip --x64",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "app:build": "electron-builder --win nsis zip --x64",
    "build": "electron-builder --win nsis zip --mac dmg zip"
  },
  "build": {
    "appId": "net.mystic9.vortex9",
    "productName": "Vortex9",
    "asar": true,
    "icon": "build/icon.png",
    "afterPack": "build/harden-fuses.js",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "shield/**/*",
      "!shield/self-check.js",
      "!shield/dev-creator.js"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "Vortex9-Windows-Setup.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Vortex9"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"],
      "artifactName": "Vortex9-macOS-Installer-${arch}.${ext}",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}
